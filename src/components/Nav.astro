---
import { site } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { label: '哲学', href: '#philosophy' },
  { label: '构建中', href: '#building' },
  { label: '维护中', href: '#maintaining' },
  { label: '工具', href: '#stack' },
];
---

<header class="nav" id="nav">
  <div class="container nav__inner">
    <a class="brand" href="/" aria-label={`${site.person.name} 首页`}>
      <span class="brand__mark" aria-hidden="true">{site.person.monogram}</span>
      <span>{site.person.name}</span>
    </a>

    <nav class="nav__links" aria-label="页面导航">
      {links.map((link) => <a class="nav__link" href={link.href}>{link.label}</a>)}
    </nav>

    <div class="nav__right">
      <a
        class="icon-btn"
        href={site.person.email.startsWith('mailto:') ? site.person.email : `mailto:${site.person.email}`}
        aria-label="发送邮件"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="1.5" y="3" width="13" height="10" rx="2" stroke="currentColor" stroke-width="1.3"></rect>
          <path d="M2.5 4.5 8 8.5l5.5-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('nav');
  if (nav) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;';
    document.body.prepend(sentinel);

    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) nav.removeAttribute('data-stuck');
        else nav.setAttribute('data-stuck', '');
      },
      { threshold: 0 }
    ).observe(sentinel);
  }
</script>
