---
import { site } from '../site.config';

const { hero } = site;
---

<section class="hero">
  <div class="container">
    {
      hero.status && (
        <a class="hero__status" href={hero.statusHref}>
          <span class="dot" aria-hidden="true" />
          {hero.status}
        </a>
      )
    }

    <h1 class="hero__title">{hero.statement}</h1>
    <p class="hero__lede">{hero.lede}</p>

    <div class="hero__actions">
      {
        hero.actions.map((action) => (
          <a
            class={`btn btn--${action.style}`}
            href={action.href}
            target={action.external ? '_blank' : undefined}
            rel={action.external ? 'noopener noreferrer' : undefined}
          >
            {action.label}
            {action.external ? (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path
                  d="M3.5 8.5 8.5 3.5M8.5 3.5H4.6M8.5 3.5v3.9"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            ) : (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path
                  d="M2.5 6h7M6.5 3l3 3-3 3"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
          </a>
        ))
      }
    </div>

    <dl class="hero__facts">
      {
        hero.facts.map((fact) => (
          <div class="fact">
            <dt class="fact__k">{fact.k}</dt>
            <dd class="fact__v">{fact.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
