---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title={`404 — ${site.person.name}`} description="这个页面不存在。">
  <section class="section notfound">
    <div class="container">
      <p class="eyebrow">404 — Not Found</p>
      <h1 class="section-title">这个页面不存在。</h1>
      <p class="section-desc">链接可能过期了，或者它从来没被写出来过。</p>
      <a class="btn btn--secondary back" href="/">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path
            d="M9.5 6h-7M5.5 3l-3 3 3 3"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        回到首页
      </a>
    </div>
  </section>
</Base>

<style>
  .notfound {
    min-height: 62vh;
    display: flex;
    align-items: center;
    border-top: none;
  }

  .notfound .section-title {
    margin-top: 16px;
  }

  .notfound .section-desc {
    margin-top: 8px;
  }

  .back {
    margin-top: 32px;
  }
</style>
